# AWS Credentials (required for Bedrock demo path)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Bedrock model (claude-3-5-haiku is fast and cheap for demos)
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# MCP server URL (change to your public HTTPS URL when deploying)
MCP_SERVER_URL=http://localhost:8000/mcp

# How many days ahead to flag expiring items (default: 5)
EXPIRY_WARN_DAYS=5
